+
+  const apiReady = () => {
+    const api = getAPI();
+    if (!api) {
+      fail("editor_unavailable", "The diagram editor is not ready");
+    }
+    if (trackedAPI !== api) {
+      unsubscribe?.();
+      trackedAPI = api;
+      signature = null;
