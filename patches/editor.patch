+
+/** A separate instance is bound to each actual editor API; never reuse state across windows. */
+export const createDiagramCommandEngine = (
+  getAPI,
+  getDocumentId,
+  options = {},
+) => {
+  const instance = randomId();
+  let counter = 0;
+  let signature = null;
+  let trackedAPI = null;
