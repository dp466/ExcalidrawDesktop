@@ -0,0 +1,44 @@
+import { startCameraTracking } from "./camera";
+
+describe("native camera sampling", () => {
+  let callback;
+  let stop;
+  let postMessage;
+  beforeEach(() => {
+    vi.useFakeTimers();
+    postMessage = vi.fn();
+    window.webkit = { messageHandlers: { excalidrawZ: { postMessage } } };
+    window.excalidrawZHelper = { _api: { onScrollChange: vi.fn((cb) => {
+      callback = cb;
+      return vi.fn();
+    }) } };
+    stop = startCameraTracking();
+  });
+  afterEach(() => {
+    stop();
+    vi.useRealTimers();
+    delete window.webkit;
+    delete window.excalidrawZHelper;
+  });
+  it("coalesces rapid updates and delivers the final camera", () => {
+    for (let i = 0; i < 120; i++) {
+      callback(i, i * 2, { value: 1.5 });
+      vi.advanceTimersByTime(8);
+    }
+    vi.advanceTimersByTime(100);
+    expect(postMessage.mock.calls.length).toBeLessThanOrEqual(10);
+    expect(postMessage).toHaveBeenLastCalledWith({ event: "onCameraChanged",
+      data: { scrollX: 119, scrollY: 238, zoom: 1.5 } });
+  });
+  it("does not deliver duplicates or pending updates after stop", () => {
+    callback(10, 20, { value: 1 });
+    vi.advanceTimersByTime(100);
+    callback(10, 20, { value: 1 });
+    vi.advanceTimersByTime(100);
+    expect(postMessage).toHaveBeenCalledTimes(1);
+    callback(30, 40, { value: 2 });
+    stop();
+    vi.advanceTimersByTime(100);
+    expect(postMessage).toHaveBeenCalledTimes(1);
+  });
+});
