+  if (!elements.length) {
+    return { x: 0, y: 0, width: 0, height: 0 };
+  }
+  const [x1, y1, x2, y2] = getCommonBounds(elements);
+  return { x: x1, y: y1, width: x2 - x1, height: y2 - y1 };
+};
