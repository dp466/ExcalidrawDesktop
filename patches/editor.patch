diff --git a/excalidraw-app/excalidrawZ/stateChange.js b/excalidraw-app/excalidrawZ/stateChange.js
new file mode 100644
index 00000000..c12bb82a
--- /dev/null
+++ b/excalidraw-app/excalidrawZ/stateChange.js
@@ -0,0 +1,166 @@
+const PERSISTENT_APP_STATE_KEYS = [
+  "viewBackgroundColor",
+  "gridSize",
+  "gridStep",
+  "gridModeEnabled",
+  "zenModeEnabled",
+  "viewModeEnabled",
+  "objectsSnapModeEnabled",
+  "isMidpointSnappingEnabled",
+  "bindingPreference",
+  "preferredSelectionTool",
+  "boxSelectionMode",
+  "stats",
+  "currentItemStrokeWidthKey",
+  "currentItemStrokeColor",
+  "currentItemBackgroundColor",
+  "currentItemStrokeStyle",
+  "currentItemFillStyle",
+  "currentItemRoughness",
+  "currentItemOpacity",
+  "currentItemFontFamily",
+  "currentItemFontSize",
+  "currentItemTextAlign",
+  "currentItemRoundness",
+  "currentItemArrowType",
+  "currentItemStartArrowhead",
+  "currentItemEndArrowhead",
+  "currentItemStrokeVariability",
+];
+
+const VIEWPORT_APP_STATE_KEYS = ["scrollX", "scrollY", "zoom"];
+
+const copyAppStateKeys = (appState, keys) => {
+  const selected = {};
+  for (const key of keys) {
+    if (Object.prototype.hasOwnProperty.call(appState ?? {}, key)) {
+      selected[key] = appState[key];
+    }
+  }
+  return selected;
+};
+
+const stringifyForSignature = (value) => {
+  try {
+    return JSON.stringify(value ?? {});
+  } catch (error) {
+    console.warn("[watchExcalidrawState] failed to stringify appState", error);
+    return `unserializable:${Date.now()}`;
+  }
+};
+
+const updateHash = (hash, value) => {
+  const text = String(value ?? "");
+  for (let i = 0; i < text.length; i++) {
+    hash = (hash << 5) + hash + text.charCodeAt(i);
+  }
+  return hash >>> 0;
+};
+
+const getContentSummary = (elements) => {
+  let hash = updateHash(5381, elements.length);
+  let deletedElementCount = 0;
+  let fileElementCount = 0;
+
+  for (const element of elements) {
+    hash = updateHash(hash, element?.id);
+    hash = updateHash(hash, element?.version);
+    hash = updateHash(hash, element?.versionNonce);
+    hash = updateHash(hash, element?.isDeleted ? 1 : 0);
+    hash = updateHash(hash, element?.index);
+    hash = updateHash(hash, element?.fileId);
+    deletedElementCount += element?.isDeleted ? 1 : 0;
+    fileElementCount += element?.fileId ? 1 : 0;
+  }
+
+  return {
+    signature: `${elements.length}:${hash}`,
+    deletedElementCount,
+    fileElementCount,
+  };
+};
+
+const readAppState = (appState) => {
+  const persistentAppState = copyAppStateKeys(
+    appState,
+    PERSISTENT_APP_STATE_KEYS,
+  );
+  const viewportAppState = copyAppStateKeys(appState, VIEWPORT_APP_STATE_KEYS);
+  return {
+    persistentAppState,
+    viewportAppState,
+    persistentSignature: stringifyForSignature(persistentAppState),
+    viewportSignature: stringifyForSignature(viewportAppState),
+  };
+};
+
+/**
+ * Tracks the native bridge subset of Excalidraw state. Scene nonce is the
+ * authoritative content invalidation signal because elements may mutate in
+ * place while retaining the same array identity.
+ */
+export class NativeStateChangeTracker {
+  lastSceneNonce = undefined;
+  lastContentSignature = null;
+  lastPersistentAppStateSignature = null;
+  lastViewportSignature = null;
+
+  reset(elements, appState, sceneNonce) {
+    const content = getContentSummary(elements);
+    const selectedAppState = readAppState(appState);
+    this.lastSceneNonce = sceneNonce;
+    this.lastContentSignature = content.signature;
+    this.lastPersistentAppStateSignature = selectedAppState.persistentSignature;
+    this.lastViewportSignature = selectedAppState.viewportSignature;
+  }
+
+  createPayload(elements, appState, sceneNonce) {
+    const selectedAppState = readAppState(appState);
+    const persistentAppStateDirty =
+      selectedAppState.persistentSignature !==
+      this.lastPersistentAppStateSignature;
+    const viewportDirty =
+      selectedAppState.viewportSignature !== this.lastViewportSignature;
+
+    // Old editor builds do not expose a nonce. Preserve the full signature
+    // fallback in that case rather than risking a missed content edit.
+    const mustInspectContent =
+      sceneNonce === undefined || sceneNonce !== this.lastSceneNonce;
+    let contentDirty = false;
+    let contentSummary = null;
+    if (mustInspectContent) {
+      contentSummary = getContentSummary(elements);
+      contentDirty = contentSummary.signature !== this.lastContentSignature;
+      this.lastContentSignature = contentSummary.signature;
+      this.lastSceneNonce = sceneNonce;
+    }
+
+    if (!contentDirty && !persistentAppStateDirty && !viewportDirty) {
+      return null;
+    }
+
+    this.lastPersistentAppStateSignature = selectedAppState.persistentSignature;
+    this.lastViewportSignature = selectedAppState.viewportSignature;
+
+    return {
+      dirty: true,
+      contentDirty,
+      appStateDirty: persistentAppStateDirty || viewportDirty,
+      persistentAppStateDirty,
+      viewportDirty,
+      appState: {
+        ...selectedAppState.persistentAppState,
+        ...selectedAppState.viewportAppState,
+      },
+      elementCount: elements.length,
+      deletedElementCount: contentSummary?.deletedElementCount ?? null,
+      fileElementCount: contentSummary?.fileElementCount ?? null,
+      appStateKeyCount:
+        Object.keys(selectedAppState.persistentAppState).length +
+        Object.keys(selectedAppState.viewportAppState).length,
+      appStateChars:
+        selectedAppState.persistentSignature.length +
+        selectedAppState.viewportSignature.length,
+    };
+  }
+}
