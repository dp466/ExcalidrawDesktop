+  id: "rect",
+  version: 1,
+  versionNonce: 10,
+  index: "a0",
+  isDeleted: false,
+};
+
+describe("native state change tracking", () => {
+  it("classifies pan as viewport-only without scanning a stable scene", () => {
+    const elements = [rectangle];
+    const tracker = new NativeStateChangeTracker();
+    tracker.reset(elements, appState(), 1);
+
+    const payload = tracker.createPayload(
+      elements,
+      appState({ scrollX: 120, scrollY: -30 }),
+      1,
+    );
+
+    expect(payload).toMatchObject({
+      contentDirty: false,
+      appStateDirty: true,
+      persistentAppStateDirty: false,
+      viewportDirty: true,
+      deletedElementCount: null,
+      fileElementCount: null,
+    });
+    expect(payload.appState).not.toHaveProperty("selectedElementIds");
+  });
+
+  it("detects an in-place content edit using the scene nonce", () => {
+    const elements = [{ ...rectangle }];
+    const tracker = new NativeStateChangeTracker();
+    tracker.reset(elements, appState(), 10);
+
+    elements[0].version += 1;
+    elements[0].versionNonce += 1;
+    const payload = tracker.createPayload(elements, appState(), 11);
+
+    expect(payload).toMatchObject({
+      contentDirty: true,
+      persistentAppStateDirty: false,
+      viewportDirty: false,
+    });
+  });
+
+  it("classifies drawing defaults as persistent preferences", () => {
+    const tracker = new NativeStateChangeTracker();
+    tracker.reset([rectangle], appState(), 1);
+
+    const payload = tracker.createPayload(
+      [rectangle],
+      appState({ currentItemStrokeColor: "#e03131" }),
+      1,
+    );
+
+    expect(payload).toMatchObject({
+      contentDirty: false,
+      persistentAppStateDirty: true,
+      viewportDirty: false,
+    });
+  });
+
+  it("detects undo and loaded-image mutations on the same array", () => {
+    const elements = [{ ...rectangle }];
+    const tracker = new NativeStateChangeTracker();
+    tracker.reset(elements, appState(), 20);
+
+    elements[0].version = 2;
+    elements[0].versionNonce = 20;
+    expect(tracker.createPayload(elements, appState(), 21)?.contentDirty).toBe(
+      true,
+    );
+
+    elements[0].version = 3;
