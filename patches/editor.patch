+  elements: 20000,
+  inspect_page: 1000,
+  render_dimension: 4096,
+  assets_bytes: 32 * 1024 * 1024,
+  request_cache: 512,
+};
+const clone = (value) => JSON.parse(JSON.stringify(value));
+const stable = (value) =>
+  JSON.stringify(value, (_, item) =>
+    item && typeof item === "object" && !Array.isArray(item)
+      ? Object.keys(item)
+          .sort()
+          .reduce((o, key) => {
+            o[key] = item[key];
+            return o;
+          }, {})
+      : item,
+  );
+const fail = (code, message, data) => {
+  const error = new Error(message);
+  error.code = code;
+  error.data = data;
+  throw error;
+};
+const finite = (value, field) => {
+  if (typeof value !== "number" || !Number.isFinite(value)) {
+    fail("invalid_arguments", `${field} must be a finite number`);
+  }
+  return value;
+};
+const positive = (value, field) => {
+  finite(value, field);
+  if (value <= 0) {
+    fail("invalid_arguments", `${field} must be positive`);
+  }
+  return value;
+};
