+import { NativeStateChangeTracker } from "./stateChange";
+
+const appState = (overrides = {}) => ({
+  viewBackgroundColor: "#ffffff",
+  currentItemStrokeColor: "#1b1b1f",
+  scrollX: 0,
+  scrollY: 0,
+  zoom: { value: 1 },
+  selectedElementIds: {},
+  ...overrides,
+});
+
