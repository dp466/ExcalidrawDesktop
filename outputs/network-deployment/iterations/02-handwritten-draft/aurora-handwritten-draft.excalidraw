": null, "verticalAlign": "top", "textAlign": "left", "autoResize": true, "angle": 0, "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.7, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "index": null, "roundness": null, "seed": 1444, "version": 1, "versionNonce": 2444, "isDeleted": false, "boundElements": null, "updated": 0, "link": null, "locked": false}, {"id": "note-body-0", "type": "text", "x": 2220, "y": 2782, "text": "Active / passive firewall pair.\nBoth WAN circuits terminate on the HA pair.\nL2 MLAG cores; dual access uplinks.\nHypervisor cluster on isolated shared storage.", "fontFamily": 5, "fontSize": 19, "strokeColor": "#657080", "groupIds": [], "frameId": "topology-frame", "width": 1010, "autoResize": false, "height": 95.0, "originalText": "Active / passive firewall pair.\nBoth WAN circuits terminate on the HA pair.\nL2 MLAG cores; dual access uplinks.\nHypervisor cluster on isolated shared storage.", "lineHeight": 1.25, "baseline": 19, "containerId": null, "verticalAlign": "top", "textAlign": "left", "angle": 0, "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.7, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "index": null, "roundness": null, "seed": 1445, "version": 1, "versionNonce": 2445, "isDeleted": false, "boundElements": null, "updated": 0, "link": null, "locked": false}, {"id": "note-head-1", "type": "text", "x": 2220, "y": 2925, "text": "Access & security", "fontFamily": 5, "fontSize": 24, "strokeColor": "#343d4b", "groupIds": [], "frameId": "topology-frame", "width": 208.704, "height": 30.0, "originalText": "Access & security", "lineHeight": 1.25, "baseline": 24, "containerId": null, "verticalAlign": "top", "textAlign": "left", "autoResize": true, "angle": 0, "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.7, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "index": null, "roundness": null, "seed": 1446, "version": 1, "versionNonce": 2446, "isDeleted": false, "boundElements": null, "updated": 0, "link": null, "locked": false}, {"id": "note-body-1", "type": "text", "x": 2220, "y": 2967, "text": "Guest networks have Internet access only.\nManagement requires MFA via jump host.\nIoT reaches DNS / NTP and allowlisted services.\nBackups use separate credentials and VLAN.", "fontFamily": 5, "fontSize": 19, "strokeColor": "#657080", "groupIds": [], "frameId": "topology-frame", "width": 1010, "autoResize": false, "height": 95.0, "originalText": "Guest networks have Internet access only.\nManagement requires MFA via jump host.\nIoT reaches DNS / NTP and allowlisted services.\nBackups use separate credentials and VLAN.", "lineHeight": 1.25, "baseline": 19, "containerId": null, "verticalAlign": "top", "textAlign": "left", "angle": 0, "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.7, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "index": null, "roundness": null, "seed": 1447, "version": 1, "versionNonce": 2447, "isDeleted": false, "boundElements": null, "updated": 0, "link": null, "locked": false}, {"id": "note-head-2", "type": "text", "x": 2220, "y": 3110, "text": "Deployment sequence", "fontFamily": 5, "fontSize": 24, "strokeColor": "#343d4b", "groupIds": [], "frameId": "topology-frame", "width": 243.816, "height": 30.0, "originalText": "Deployment sequence", "lineHeight": 1.25, "baseline": 24, "containerId": null, "verticalAlign": "top", "textAlign": "left", "autoResize": true, "angle": 0, "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.7, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "index": null, "roundness": null, "seed": 1448, "version": 1, "versionNonce": 2448, "isDeleted": false, "boundElements": null, "updated": 0, "link": null, "locked": false}, {"id": "note-body-2", "type": "text", "x": 2220, "y": 3152, "text": "1. Stage VLANs, DHCP, DNS and policies.\n2. Test WAN / firewall / core failure paths.\n3. Migrate clients and application workloads.\n4. Verify VPN, monitoring and restore a backup.", "fontFamily": 5, "fontSize": 19, "strokeColor": "#657080", "groupIds": [], "frameId": "topology-frame", "width": 1010, "autoResize": false, "height": 95.0, "originalText": "1. Stage VLANs, DHCP, DNS and policies.\n2. Test WAN / firewall / core failure paths.\n3. Migrate clients and application workloads.\n4. Verify VPN, monitoring and restore a backup.", "lineHeight": 1.25, "baseline": 19, "containerId": null, "verticalAlign": "top", "textAlign": "left", "angle": 0, "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.7, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "index": null, "roundness": null, "seed": 1449, "version": 1, "versionNonce": 2449, "isDeleted": false, "boundElements": null, "updated": 0, "link": null, "locked": false}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}